# Salin file ini menjadi backend/.env lalu isi nilainya.

# Kunci API Claude untuk fitur "scan nota pakai AI".
# Kalau dikosongkan, scan tetap jalan memakai pembaca nota biasa (OCR) di browser.
ANTHROPIC_API_KEY=

# Model AI pembaca nota (bawaan: claude-opus-5-5).
# JUALANS_AI_MODEL=claude-opus-5-5

# Lokasi database. Bawaan: SQLite di backend/jualans.db.
# Bisa diganti ke PostgreSQL, misalnya: postgresql+psycopg://user:pass@localhost/jualans
# JUALANS_DATABASE_URL=sqlite:///./jualans.db

# Buat akun demo berisi data contoh 3 bulan (1 = ya, 0 = tidak).
# JUALANS_DEMO=1
